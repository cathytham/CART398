// 05
shape(99,0.2)
  .repeat(8,8)
  .modulate(noise(3,0.2))
  .color(0.3,1,0.9)
  .rotate(()=>time*0.2)
  .scale(()=>Math.sin(time)*0.25+1)
  .kaleid(8)
  .saturate(2)
  .posterize(3)
  .out()
