// 01
let track1 = stack(
  s("bd")
    .struct("1 ~ 0 ~ 1 0 ~ 0")
    .gain(0.9),

  s("sd")
    .struct("~ 0 1 ~ ~ 0 1 ~")
    .gain(0.6)
    .room(0.2),

  s("hh*8")
    .gain(0.25)
    .pan("<-0.2 0.2>")
)

let track2 = stack(
  s("bd")
    .struct("1 ~ ~ 1 0 ~ 1 ~")
    .gain(0.9),

  s("rim")
    .struct("~ 0 1 ~ ~ 0 1 ~")
    .gain(0.5),

  s("hh*16")
    .gain(0.2)
    .pan("<-0.3 0.3>")
)

let track3 = stack(
  s("bd")
    .struct("1 0 ~ 1 ~ 0 1 0")
    .gain(0.9),

  s("sd")
    .struct("~ ~ 1 ~ ~ 0 1 ~")
    .gain(0.6)
    .room(0.3),

  s("hh*16")
    .gain(0.18),

  s("shaker*8")
    .gain(0.15)
    .room(0.2)
)

$: arrange(
  [3, track1],
  [4, track2],
  [6, track3],
  [4, stack(track1,track2,track3)]
)
