// 04

shape(7,0.4,0.4)
  .repeat(6,6)
  .rotate(()=>time*0.3)
  .mult(
    osc(20,0.1,3)
      .kaleid(9)
      .color(0.5,0.2,1.5)
  )
  .modulate(
    noise(3,0.2)
      .scale(()=>Math.sin(time*0.5)*0.3+1)
  ,0.4)
  .add(
    osc(6,-0.1,2)
      .kaleid(12)
      .color(
        ()=>Math.sin(time*0.4)+1,
        0.3,
        ()=>Math.cos(time*0.4)+1.2
      )
  )
  .scale(()=>Math.sin(time*0.3)*0.4+1.4)
  .contrast(1.8)
  .saturate(2)
  .out(o0)

render(o0)src(o0)
  .modulate(noise(2,0.1),0.02)
  .blend(o0,0.9)
  .out(o0)

render(o0)
