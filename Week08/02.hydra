// 02

osc(8,0.3,2)
  .diff(o0)
  .kaleid(6)
  .rotate(()=>time*0.1)
  .out(o0)

noise(3,0.2)
  .modulate(o1,0.4)
  .color(0.4,0.2,1.5)
  .posterize(3)
  .out(o1)

src(o0)
  .noise(o1,0.5)
  .kaleid(12)
  .scale(()=>Math.sin(time*0.2)*0.4+1.3)
  .out(o2)

render(o0)
