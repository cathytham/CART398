//03
osc(1.5,2.5,1.5)
  .color(1,0.3,1.5)
  .rotate(()=>time*0.2)
  .blend(noise(3), ()=>Math.sin(time)*0.5 + 0.5)
  .add(
    voronoi(10,2,3)
      .color(0.2,0.5,1.8)
  )
  .mult(
    shape(2,1,3)
      .repeat(4,3)
      .rotate(()=>time*0.4)
  )
  .modulate(noise(2,0.1),1)
  .out()
