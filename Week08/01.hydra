// 01
osc(20,0.1,1)
  .color(
    ()=>Math.sin(time)*0.8+1,
    ()=>Math.cos(time*0.5)*0.5+0.5,
    ()=>Math.sin(time*0.3)*1.2+1
  )
  .modulateRotate(osc(5,0.2),0.6)
  .modulateKaleid(o0,0.4)
  .out()
